# Enter these in Coolify. Never commit real values.
# Generate each password independently: openssl rand -hex 32
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
TS_AUTHKEY=
TS_HOSTNAME=hallows-marketing
PAPERCLIP_PUBLIC_URL=https://hallows-marketing.YOUR-TAILNET.ts.net
# Optional if using persistent Codex login instead.
OPENAI_API_KEY=
# Pin a tested image tag/digest before production rollout.
TAILSCALE_IMAGE=tailscale/tailscale:stable
# Change deliberately when refreshing the CLI tools in the upstream image.
CLI_TOOLS_CACHE_EPOCH=2026-09-12
